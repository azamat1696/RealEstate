@model List<ResultProductAdvertListWithCategoryByEmployeeDto>
@{
    ViewBag.Title = "Aktif İlanlarım";
    Layout = "/Areas/EstateAgent/Views/LayoutEstateAgent/Index.cshtml";
}
<!-- Table Start -->
<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-12">
            <div class="bg-light rounded h-100 p-4">
                <div class="row">
                    <div class="col-6 text-start">
                        <h6 class="mb-4">Aktif İlanlar</h6>
                    </div>
                    <div class="col-6 text-end">
                        <a href="/EstateAgent/MyAdverts/CreateAdvert" class="btn btn-outline-primary mb-4">Yeni Ürün Ekle</a>
                   </div>
                </div>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">İlan Başlığı</th>
                            <th scope="col">Açıklama</th>
                            <th scope="col">Şehir</th>
                            <th scope="col">İlçe</th>
                            <th scope="col">Adres</th>
                            <th scope="col">Kategory</th>
                            <th scope="col">Fiyat</th>
                            <th scope="col">Tür</th>
                            <th scope="col">İşlemler</th>
                        </tr>
                        </thead>
                        <tbody>
                        @{
                            int counter = 1;
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <th scope="row">@counter</th>
                                <td>@item.Title</td>
                                <td>
                                    @(item.Description != null && item.Description.Length > 30 
                                    ? item.Description.Substring(0, 30) + "..."
                                    : item.Description)
                                </td>
                                <td>@item.City</td>
                                <td>@item.District</td>
                                <td>
                                    @(item.Address != null && item.Address.Length > 30
                                    ? item.Address.Substring(0, 30) + "..."
                                    : item.Address)
                                </td>
                                <td>@item.CategoryName</td>
                                <td>@item.Price ₺</td>
                                <td>@item.Type</td>
                                <td>
                                    <a href="/Product/UpdateProduct/@item.ProductId" class="btn btn-outline-primary">Düzenle</a>
                                    <a href="/Product/DeleteProduct/@item.ProductId" onclick="return confirm('Eminmisiniz ?')" class="btn btn-outline-dark">Pasif Yap</a>
                                    <a href="/Product/ProductDetail/@item.ProductId" class="btn btn-outline-info">Sitede Gör</a>
                                </td>
                            </tr>
                            counter++;
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
