@model List<ResultEstateAgentDashboardChartDto>
<div class="container-fluid pt-4 px-4">
    <div class="row g-4 justify-content-between">
       <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.4/Chart.js"></script>
 
        <canvas id="myChart" style="width:100%;max-width:600px"></canvas>
      @{
        var xValues = new List<string>();
        var yValues = new List<int>();
        foreach (var item in Model)
        {
            xValues.Add(item.City);
            yValues.Add(item.CityCount);
        }
      }
      <script>
          const xValues = @Html.Raw(Json.Serialize(xValues));
          const yValues = @Html.Raw(Json.Serialize(yValues));
          const barColors = ["red", "green","blue","orange","brown"];

        new Chart("myChart", {
          type: "bar",
          data: {
            labels: xValues,
            datasets: [{
              backgroundColor: barColors,
              data: yValues
            }]
          },
          options: {
            legend: {display: false},
            scales: {
              yAxes: [{
                ticks: {
                  beginAtZero: true
                }
              }]
            },
        
            title: {
              display: true,
              text: "Şehir İlan İstatistikleri"
            }
          }
        });
</script>
      <canvas id="myChart2" style="width:100%;max-width:600px"></canvas>
      @{
        var xValues2 = new List<string>();
        var yValues2 = new List<int>();
        foreach (var item in Model)
        {
          xValues2.Add(item.City);
          yValues2.Add(item.CityCount);
        }
      }
      <script>
          const xValues2 = @Html.Raw(Json.Serialize(xValues2));
          const yValues2 = @Html.Raw(Json.Serialize(yValues2));
          const barColors2 = ["red", "green","blue","orange","brown"];

        new Chart("myChart2", {
          type: "bar",
          data: {
            labels: xValues2,
            datasets: [{
              backgroundColor: barColors2,
              data: yValues2
            }]
          },
          options: {
            legend: {display: false},
            scales: {
              yAxes: [{
                ticks: {
                  beginAtZero: true
                }
              }]
            },
        
            title: {
              display: true,
              text: "Şehir İlan İstatistikleri"
            }
          }
        });
</script>
    </div>
</div>