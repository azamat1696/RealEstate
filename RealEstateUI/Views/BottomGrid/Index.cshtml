@model List<ResultBottomGridDto>

@{
    ViewBag.Title = "title";
    Layout = "/Views/Admin/Index.cshtml";
}

<!-- Table Start -->
<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-12">
            <div class="bg-light rounded h-100 p-4">
                <div class="row">
                    <div class="col-6 text-start">
                        <h6 class="mb-4">Bottom Grid Tablosu</h6>
                    </div>
                    <div class="col-6 text-end">
                        <a href="/BottomGrid/CreateBottomGrid" class="btn btn-outline-primary mb-4">Yeni Ekle</a>
                   </div>
                </div>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Başlık</th>
                            <th scope="col">Açıklama</th>
                            <th scope="col">İşlemler</th>
                        </tr>
                        </thead>
                        <tbody>
                        @{
                            int counter = 1;
                        }
                        @if (Model != null)
            {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <th scope="row">@counter</th>
                                <td>@(item?.Title ?? "N/A") </td>
                                <td>
                                    @if (item?.Description != null)
                                    {
                                        @Html.Raw(item.Description)
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger p-2">Açıklama Yok</span>
                                    }
                                </td>
                                <td>
                                    <a href="/BottomGrid/UpdateBottomGrid/@(item?.BottomGridId)" class="btn btn-outline-primary">Düzenle</a>
                                    <a href="/BottomGrid/DeleteBottomGrid/@(item?.BottomGridId)" onclick="return confirm('Eminmisiniz ?')" class="btn btn-outline-danger">Sil</a>
                                </td>
                            </tr>
                            counter++;
                        }
            }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center">Veri Bulunamadı</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
