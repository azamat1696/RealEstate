@model UpdateBottomGridDto

@{
    ViewBag.Title = "Update Bottom Grid";
    Layout = "/Views/Admin/Index.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-sm-12 col-xl-12">
            <div class="bg-light rounded h-100 p-4">
                <h6 class="mb-4">Bottom Grid Güncelle</h6>
                <form method="post">
                    <input type="hidden" asp-for="BottomGridId" />
                    <div class="mb-3">
                        <label class="form-label fw-bold">Başlık</label>
                        <input type="text" class="form-control" asp-for="Title">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">İkon</label>
                        <input type="text" class="form-control" asp-for="Icon">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Açıklama</label>
                    <textarea rows="5" class="form-control" asp-for="Description">
                    </textarea>
                    </div>
                    <button class="btn btn-primary" type="submit">Kaydet</button>
                </form>
            </div>
        </div>
    </div>
</div>