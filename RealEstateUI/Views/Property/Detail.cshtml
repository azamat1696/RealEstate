@{
    ViewBag.Title = "Emlak Detayları";
    Layout = "_DefaultLayout";
}
<section class="w3l-about-breadcrumb">
    <div class="breadcrumb-bg breadcrumb-bg-about pt-5">
        <div class="container pt-lg-5 py-3">
        </div>
    </div>
</section>
<section class="w3l-breadcrumb">
    <div class="container">
        <ul class="breadcrumbs-custom-path">
            <li><a href="/Default/Index">Ana Sayfa</a></li>
            <li class="active"><span class="fa fa-angle-right mx-2" aria-hidden="true"></span> İlanlar</li>
            <li class="active"><span class="fa fa-angle-right mx-2" aria-hidden="true"></span> İlan Detayları</li>
        </ul>
    </div>
</section>
<!--/blog-post-->
<section class="w3l-blog post-content py-5">
    <div class="container py-lg-4 py-md-3 py-2">
        <div class="inner mb-4">
            <ul class="blog-single-author-date align-items-center">
                <li>
                    <div class="listing-category"><span>@ViewBag.Type</span></div>
                </li>
                <li><span class="fa fa-clock-o"></span> Yaklaşık @ViewBag.DayDifference Ay Önce Eklendi</li>
                <li><span class="fa fa-eye"></span> 250 Kez Görüntülendi </li>
            </ul>
        </div>
        <div class="post-content">
            <h2 class="title-single"> @ViewBag.ProductName</h2>
        </div>
        <div class="blo-singl mb-4">
            <ul class="blog-single-author-date align-items-center">
                <li>
                    <p>@ViewBag.Address @ViewBag.District / @ViewBag.City</p>
                </li>
                <li><span class="fa fa-bed"></span> @ViewBag.BedRoomCount Yatak Odası</li>
                <li><span class="fa fa-bath"></span> @ViewBag.BathCount Banyo</li>
                <li><span class="fa fa-share-square-o"></span> @ViewBag.ProductSize m<sup>3</sup></li>
            </ul>
            <ul class="share-post">
                <a href="#url" class="cost-estate m-o">TL @ViewBag.Price</a>
            </ul>
        </div>
        <div class="row">
            <div class="col-lg-8 w3l-news">
                <div class="blog-single-post">
                    
                    @await Component.InvokeAsync("_PropertySliderComponentPartial", new { productId = ViewBag.ProductId }) 
                    <div class="single-post-content">
                        <h3 class="post-content-title mb-3">İlan Açıklaması</h3>
                        <p class="mb-4"> @ViewBag.Product_Description  </p>
                        <div class="single-bg-white">
                            <h3 class="post-content-title mb-4">İlan Detayları</h3>
                            <ul class="details-list">
                                <li><strong>İlan Id :</strong> @ViewBag.ProductId </li>
                                <li><strong>Metrekare :</strong> @ViewBag.ProductSize </li>
                                <li><strong>Oda Sayısı :</strong> @ViewBag.BedroomCount </li>
                                <li><strong>Yatak Odası :</strong> @ViewBag.BedroomCount </li>
                                <li><strong>Banyo Sayısı :</strong> @ViewBag.BathCount </li>
                                <li><strong>Exterior material :</strong> Brick </li>
                                <li><strong>Yapı Türü :</strong> Beton </li>
                                <li><strong>Garaj Sayısı :</strong> @ViewBag.GarageSize </li>
                                <li><strong>Garages :</strong> 15 </li>
                                <li><strong>Fiyat :</strong> TL @ViewBag.Price  </li>
                                <li><strong>Yapım Yılı :</strong> @ViewBag.BuildYear </li>
                                <li><strong>İlan Tarihi :</strong> @ViewBag.Date </li>
                               
                            </ul>
                        </div>
                        @await Component.InvokeAsync("_PropertyAmenityByStatusTrueByPropertyIdComponentPartial", new { productId = ViewBag.ProductId })
                    </div>
                    <div class="single-bg-white">
                        <h3 class="post-content-title mb-4">Location</h3>
                        <div class="agent-map">
                           <iframe src="@ViewBag.Location"></iframe>
                        </div>
                    </div>

                    <div class="single-bg-white mb-0">
                        <h3 class="post-content-title mb-4">Ev Tanıtım Videosu</h3>
                        <div class="post-content">
                            <iframe src="@ViewBag.VideoUrl" frameborder="0"
                                allowfullscreen=""></iframe>
                        </div>
                    </div>
                </div>
            </div>
            <div class="sidebar-side col-lg-4 col-md-12 col-sm-12 mt-lg-0 mt-5">
                <aside class="sidebar">

                    <!-- Popular Post Widget-->
                 @await Component.InvokeAsync("_PropertyAppUserComponentPartial", new { productId = ViewBag.ProductId })
                    <!-- Popular Post Widget-->
                    <div class="sidebar-widget popular-posts">
                        <div class="sidebar-title">
                            <h4>Emlakçıya Ait İlanlar</h4>
                        </div>

                        <article class="post">
                            <figure class="post-thumb"><img src="~/starter/assets/images/l1.jpg" class="radius-image" alt="">
                            </figure>
                            <div class="text"><a href="#blog-single">Why we are the best in the business
                                </a>
                                <div class="post-info">Sep 09, 2020 - 2 comments</div>
                            </div>
                        </article>

                        <article class="post">
                            <figure class="post-thumb"><img src="~/starter/assets/images/l2.jpg" class="radius-image" alt="">
                            </figure>
                            <div class="text"><a href="#blog-single">Build your next landing page.
                                </a>
                                <div class="post-info">Sep 09, 2020 - 2 comments</div>
                            </div>
                        </article>

                        <article class="post">
                            <figure class="post-thumb"><img src="~/starter/assets/images/l3.jpg" class="radius-image" alt="">
                            </figure>
                            <div class="text"><a href="#blog-single">
                                    Simply the best. Better than the rest.</a>
                                <div class="post-info">Sep 10, 2020 - 2 comments</div>
                            </div>
                        </article>

                    </div>

                </aside>
            </div>
        </div>
    </div>
</section>
<!--//blog-posts-->