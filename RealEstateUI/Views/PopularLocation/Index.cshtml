@model List<ResultPopularLocationDto>

@{
    ViewBag.Title = "title";
    Layout = "/Views/Admin/Index.cshtml";
}

<!-- Table Start -->
<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-12">
            <div class="bg-light rounded h-100 p-4">
                <div class="row">
                    <div class="col-6 text-start">
                        <h6 class="mb-4">Popüler Konumlar Tablosu</h6>
                    </div>
                    <div class="col-6 text-end">
                        <a href="/PopularLocation/CreatePopularLocation" class="btn btn-outline-primary mb-4">Yeni Ekle</a>
                   </div>
                </div>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Şehir Adı</th>
                            <th scope="col">Resim</th>
                            <th scope="col">İşlemler</th>
                        </tr>
                        </thead>
                        <tbody>
                        @{
                            int counter = 1;
                        }
                        @if (Model != null)
            {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <th scope="row">@counter</th>
                                <td>@(item?.CityName ?? "N/A") </td>
                                <td>
                                    <img src="@item?.ImageUrl" alt="Icon" style="width: 50px; height: 50px;" />
                                </td>
                                <td>
                                    <a href="/PopularLocation/UpdatePopularLocation/@(item?.LocationId)" class="btn btn-outline-primary">Düzenle</a>
                                    <a href="/PopularLocation/DeletePopularLocation/@(item?.LocationId)" onclick="return confirm('Eminmisiniz ?')" class="btn btn-outline-danger">Sil</a>
                                </td>
                            </tr>
                            counter++;
                        }
            }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center">Veri Bulunamadı</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
