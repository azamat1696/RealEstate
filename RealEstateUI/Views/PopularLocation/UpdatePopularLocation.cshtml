@model UpdatePopularLocationDto

@{
    ViewBag.Title = "Update Bottom Grid";
    Layout = "/Views/Admin/Index.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-sm-12 col-xl-12">
            <div class="bg-light rounded h-100 p-4">
                <h6 class="mb-4">Popüler Konumlar Güncelle</h6>
                <form method="post">
                    <input type="hidden" asp-for="LocationId" />
                    <div class="mb-3">
                        <label class="form-label fw-bold">Şehir Adı</label>
                        <input type="text" class="form-control" asp-for="CityName">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Resim</label>
                        <input type="text" class="form-control" asp-for="ImageUrl">
                    </div>
                    <button class="btn btn-primary" type="submit">Kaydet</button>
                </form>
            </div>
        </div>
    </div>
</div>