@model List<RealEstateUI.Dto.WhoWeAreDtos.ResultWhoWeAreDto>?
@{
    ViewBag.Title = "title";
    Layout = "/Views/Admin/Index.cshtml";
}

<!-- Table Start -->
<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-12">
            <div class="bg-light rounded h-100 p-4">
                <div class="row">
                    <div class="col-6 text-start">
                        <h6 class="mb-4">Biz kimiz Tablosu</h6>
                    </div>
                    <div class="col-6 text-end">
                        <a href="/WhoWeAre/CreateWhoWeAre" class="btn btn-outline-primary mb-4">Yeni Ekle</a>
                   </div>
                </div>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Başlık</th>
                            <th scope="col">Alt Başlık</th>
                            <th scope="col">Açıklama 1</th>
                            <th scope="col">Açıklama 2</th>
                            <th scope="col">İşlemler</th>
                        </tr>
                        </thead>
                        <tbody>
                        @{
                            int counter = 1;
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <th scope="row">@counter</th>
                                <td>@item.title</td>
                                <td>@item.subTitle</td>
                                <td>@item.description1</td>
                                <td>@item.description2</td>
                                <td>
                                    <a href="/WhoWeAre/UpdateWhoWeAre/@item.WhoWeAreDetailId" class="btn btn-outline-primary">Düzenle</a>
                                    <a href="/WhoWeAre/DeleteWhoWeAre/@item.WhoWeAreDetailId" onclick="return confirm('Eminmisiniz ?')" class="btn btn-outline-danger">Sil</a>
                                </td>
                            </tr>
                            counter++;
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
